# Copy values into .env.docker or export before running acceptance tests.
# Do not commit real secrets.

ACCEPTANCE_UI_E2E=1
E2E_BASE_URL=http://localhost:9806
E2E_USERNAME=admin
E2E_PASSWORD=change-me

# Seeded by tests/ui/fixtures_acceptance.py (or set manually after seed)
ACCEPTANCE_JOB_ID=

# Real SMTP for task 109636 (defaults to SMTP_SENDER_* from .env.docker)
ACCEPTANCE_SMTP_PROVIDER=mailru
ACCEPTANCE_SMTP_EMAIL=
ACCEPTANCE_SMTP_PASSWORD=

# Bitrix reporting (same webhook as bitrix MCP)
BITRIX_WEBHOOK_BASE=https://portal.example.ru/rest/123/secret_token/
