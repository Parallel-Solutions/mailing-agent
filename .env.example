APP_USERNAME=admin
APP_PASSWORD=change-me
APP_HOST=0.0.0.0
APP_PORT=9806

OPENAI_API_KEY=replace-with-shared-openai-key
OPENAI_BASE_URL=https://api.vsellm.ru/v1

# Optional dedicated key for generator-side AI flow.
# If set, generator/case-review components will use it instead of OPENAI_API_KEY.
GENERATOR_OPENAI_API_KEY=replace-with-generator-openai-key
GENERATOR_OPENAI_BASE_URL=https://api.openai.com/v1

CASE_AGENT_MODEL=gpt-4o-mini
ENABLE_CASE_AGENT=1
CASE_AGENT_MODE=auto_fix
CASE_AGENT_ONLY_SUSPICIOUS=1
WEB_CASE_AGENT_MAX_WORKERS=1
PHILOLOGIST_AUTO_RUN_ENABLED=1

PDF_CONVERTER=libreoffice
# Optional: fallback backend if the primary converter fails.
# Examples: libreoffice, onlyoffice
PDF_CONVERTER_FALLBACK=

# ONLYOFFICE Docs / Document Server settings
# Recommended local-Docker scenario: use upload mode, so the server receives the DOCX directly
# and you do not need a temporary public URL for every file.
ONLYOFFICE_BASE_URL=http://127.0.0.1:8080
ONLYOFFICE_CONVERTER_MODE=upload
ONLYOFFICE_CONVERT_TIMEOUT_SECONDS=120

# Optional: if JWT is enabled in ONLYOFFICE Docs.
ONLYOFFICE_JWT_SECRET=

# Optional: needed only if you later switch to /converter URL mode.
ONLYOFFICE_PUBLIC_FILES_URL=

SMTP_SENDER_EMAIL=replace@example.com
SMTP_SENDER_PASSWORD=replace-with-smtp-password
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USE_STARTTLS=0
SMTP_ALLOW_REAL_SEND=1

SENDER_TRANSPORT=unisender
SENDER_DELAY_SECONDS=60
DOCUMENTS_WORKER_MAX_PROCESSES=1
SENDER_WORKER_MAX_PROCESSES=1
DOCUMENTS_WORKER_TIMEOUT_SECONDS=21600
SENDER_WORKER_TIMEOUT_SECONDS=7200
UNISENDER_API_KEY=replace-with-unisender-key
UNISENDER_API_BASE_URL=https://goapi.unisender.ru/ru/transactional/api/v1
UNISENDER_SENDER_NAME=Company Name
UNISENDER_SENDER_EMAIL=replace@example.com
UNISENDER_LIST_ID=1

RUSENDER_API_KEY=replace-with-rusender-key
RUSENDER_API_BASE_URL=https://api.rusender.ru/api/v1
RUSENDER_SENDER_NAME=Company Name
RUSENDER_SENDER_EMAIL=replace@example.com
RUSENDER_WEBHOOK_SECRET=replace-with-rusender-webhook-secret
