# Copy this file to .env.docker and fill real secrets there.
# Do not commit .env.docker.

APP_USERNAME=admin
APP_PASSWORD=change-me
APP_ENVIRONMENT=local
DATABASE_EXPECTED_NAME=mailing
APP_ADMIN_TENANT_ID=admin
APP_SESSION_TTL_DAYS=7
APP_ALLOW_REGISTRATION=0
# Optional CampaignFlow MCP static tokens: JSON map token -> username
# Example: MAILING_AGENT_MCP_TOKENS={"dev-mcp-token":"demo"}
MAILING_AGENT_MCP_TOKENS=


# PostgreSQL
DATABASE_URL=postgresql+psycopg://mailing:mailing@postgres:5432/mailing

# S3 / MinIO
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mailing-agent
S3_REGION=us-east-1
S3_USE_PATH_STYLE=1

# Redis
REDIS_URL=redis://redis:6379

# Local workspace for document generation
WORKSPACE_DIR=/app/tmp
USER_WORKER_MAX_PROCESSES_PER_TASK=1
USER_INPROCESS_MAX_TASKS=1
# Optional multi-user map. JSON object: username -> {password, tenant_id, role}.
# Example for 5 users:
# APP_USERS={"alice":{"password":"...","tenant_id":"team","role":"user"},"bob":{"password":"...","tenant_id":"team","role":"user"}}
APP_USERS=
APP_HOST=0.0.0.0
APP_PORT=9806
APP_PUBLIC_PORT=9806
# Must match the public HTTPS hostname that recipients can open (email links + webhooks).
# Common typo: offer.parrpesh.ru (NXDOMAIN) — use offer.parresh.ru instead.
PUBLIC_BASE_URL=https://offer.parresh.ru
# First-party approximate open tracking for messages sent through SMTP.
SMTP_OPEN_TRACKING_ENABLED=1

OPENAI_API_KEY=replace-with-openai-key
OPENAI_BASE_URL=https://api.vsellm.ru/v1
# Optional dedicated key for generator-side AI flow.
GENERATOR_OPENAI_API_KEY=
GENERATOR_OPENAI_BASE_URL=https://api.openai.com/v1
TEMPLATE_AI_MODELS=gpt-4o-mini,gpt-4.1
# Iterative DOCX/PDF import: max vision rounds, USD budget cap, PNG similarity early-exit.
TEMPLATE_IMPORT_MAX_ROUNDS=10
TEMPLATE_IMPORT_MAX_COST_USD=1.5
TEMPLATE_IMPORT_TARGET_SIMILARITY=0.97
CASE_AGENT_MODEL=gpt-4o-mini
ENABLE_CASE_AGENT=1
CASE_AGENT_MODE=auto_fix
CASE_AGENT_ONLY_SUSPICIOUS=1
WEB_CASE_AGENT_MAX_WORKERS=1
PHILOLOGIST_AUTO_RUN_ENABLED=1

KP_GENERATION_ENGINE=template
PDF_CONVERTER=gotenberg
PDF_CONVERTER_FALLBACK=
PDF_WORKERS=2
PDF_CHUNK_SIZE=10
GOTENBERG_BASE_URL=http://gotenberg:3000
GOTENBERG_BASE_URLS=http://gotenberg:3000,http://gotenberg-2:3000
GOTENBERG_CONVERT_TIMEOUT_SECONDS=300

SENDER_TRANSPORT=rusender
SENDER_DELAY_SECONDS=60
# SMTP: set min/max to make pauses random, for example 179..247 seconds = 2:59..4:07.
SENDER_DELAY_MIN_SECONDS=0
SENDER_DELAY_MAX_SECONDS=0
DOCUMENTS_WORKER_MAX_PROCESSES=2
DOCUMENTS_WORKER_TIMEOUT_SECONDS=21600
TEMPLATE_TEXT_EXTRACTION_TIMEOUT_SECONDS=120
SENDER_WORKER_MAX_PROCESSES=1
SENDER_WORKER_TIMEOUT_SECONDS=7200
BACKGROUND_QUEUE_ENABLED=1
BACKGROUND_QUEUE_POLL_SECONDS=1
BACKGROUND_QUEUE_LEASE_SECONDS=7200
BACKGROUND_QUEUE_HEARTBEAT_SECONDS=30
BACKGROUND_QUEUE_RETRY_BASE_SECONDS=30
BACKGROUND_QUEUE_MAX_ATTEMPTS=3
BACKGROUND_QUEUE_SHUTDOWN_GRACE_SECONDS=20
SENDER_DOMAIN_LIMITS_JSON={"gmail.com":60,"mail.ru":40,"yandex.ru":40,"outlook.com":40,"other":30}
SENDER_DOMAIN_LIMIT_WINDOW_SECONDS=3600
SEND_GUARD_WINDOW_SECONDS=3600
SEND_GUARD_COMPLAINT_RATE_THRESHOLD=0.001
SEND_GUARD_API_ERROR_RATE_THRESHOLD=0.05
SUPPRESSION_SOFT_BOUNCE_TTL_DAYS=7

# Validate every recipient with SMTP.BZ before delivery.
# Copy the API key from https://smtp.bz/panel/ and keep FAIL_OPEN=0 to block
# unverified sends when the key, quota, or validator API is unavailable.
EMAIL_VALIDATION_MODE=smtpbz
EMAIL_VALIDATION_TIMEOUT_SECONDS=10
EMAIL_VALIDATION_CONCURRENCY=10
EMAIL_VALIDATION_MAX_ATTEMPTS=2
SMTPBZ_API_KEY=replace-with-smtpbz-api-key
SMTPBZ_API_BASE_URL=https://api.smtp.bz/v1
SMTPBZ_FAIL_OPEN=0

SMTP_SENDER_EMAIL=replace@example.com
SMTP_SENDER_PASSWORD=replace-with-smtp-password
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USE_STARTTLS=0
SMTP_ALLOW_REAL_SEND=0
# Fernet key for encrypted SMTP mailboxes (required for /api/smtp/mailboxes).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMTP_CREDENTIALS_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
SMTP_OAUTH_REDIRECT_BASE=http://localhost:9806
SMTP_SETUP_AI_ENABLED=1

UNISENDER_API_KEY=
UNISENDER_API_BASE_URL=https://goapi.unisender.ru/ru/transactional/api/v1
UNISENDER_SENDER_NAME=Company Name
UNISENDER_SENDER_EMAIL=replace@example.com
UNISENDER_LIST_ID=1
UNISENDER_WEBHOOK_SECRET=replace-with-unisender-webhook-secret

RUSENDER_API_KEY=replace-with-rusender-key
# One shared access key for all RuSender connections; sending key IDs are configured in the UI.
RUSENDER_API_BASE_URL=https://api.rusender.ru/api/v1
RUSENDER_SENDER_NAME=Company Name
RUSENDER_SENDER_EMAIL=replace@example.com
# 0 = direct hrefs in email (stable chain/consent links); 1 = RuSender click proxy (clicks.clicksends.net)
RUSENDER_TRACK_LINKS=0
RUSENDER_WEBHOOK_SECRET=replace-with-rusender-webhook-secret

MAILOPOST_API_TOKEN=replace-with-mailopost-token
MAILOPOST_API_BASE_URL=https://api.mailopost.ru/v1
MAILOPOST_SENDER_NAME=Company Name
MAILOPOST_SENDER_EMAIL=replace@example.com
MAILOPOST_WEBHOOK_SECRET=replace-with-mailopost-webhook-secret
WEBHOOK_MAX_BODY_BYTES=262144
CONSENT_TOKEN_TTL_HOURS=720
KP_ADAPTIVE_TEMPLATE_ENGINE=1

# Browser URL for the embedded DOCX editor and the internal URL used by Document Server.
ONLYOFFICE_EDITOR_PUBLIC_URL=http://localhost:8080
ONLYOFFICE_APP_INTERNAL_URL=http://app:9806
ONLYOFFICE_EDITOR_INTERNAL_URL=http://onlyoffice
ONLYOFFICE_PUBLIC_PORT=8080
ONLYOFFICE_EDITOR_TOKEN_SECRET=replace-with-a-long-random-secret
ONLYOFFICE_JWT_SECRET=replace-with-a-separate-long-random-jwt-secret
