# Playwright Docker E2E (safe examples only).
# Copy to .env.e2e (gitignored). Do not put production secrets here.
#
# Also used as --env-file for docker compose e2e overlay.
# RuSender live matrix still documents copying this file to .env.docker when needed;
# for Playwright+Mailpit prefer .env.e2e and keep .env.docker for base stack secrets.

APP_ENV=test
APP_USERNAME=admin
APP_PASSWORD=change-me
APP_ALLOW_REGISTRATION=0

# Fernet key for SMTP mailbox vault (test-only example; generate your own for shared envs)
SMTP_CREDENTIALS_KEY=KMhHbRYezchgJCwbtKxIw97zOrwo5UJI1glFM5moTp8=

# Use alias "web" (not "app"): Chromium forces HTTPS for hostname "app".
E2E_BASE_URL=http://web:9806
E2E_API_URL=http://web:9806
MAILPIT_API_URL=http://mailpit:8025
MAILPIT_UI_PORT=8025

E2E_USERNAME=admin
E2E_PASSWORD=change-me
E2E_USER_EMAIL=e2e@example.test

E2E_SMTP_SENDER_EMAIL=e2e-sender@example.test
E2E_SMTP_SENDER_PASSWORD=mailpit-e2e

RUN_LIVE_EMAIL_TESTS=0

# --- Optional: existing RuSender API matrix (not used by Playwright Mailpit suite) ---
# RUN_REAL_E2E=0
# SENDER_TRANSPORT=rusender
# RUSENDER_API_KEY=
# RUSENDER_SENDER_EMAIL=
