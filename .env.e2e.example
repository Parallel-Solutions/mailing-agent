# Copy to .env.docker (or export before running E2E) and fill real secrets.
# Used by docker compose + tests/e2e/run_send_matrix.py

APP_USERNAME=admin
APP_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg://mailing:mailing@postgres:5432/mailing
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mailing-agent
S3_REGION=us-east-1
S3_USE_PATH_STYLE=1
REDIS_URL=redis://redis:6379

WORKSPACE_DIR=/app/tmp
PUBLIC_BASE_URL=http://localhost:9806

# Document generation
KP_GENERATION_ENGINE=template
PDF_CONVERTER=gotenberg
GOTENBERG_BASE_URL=http://gotenberg:3000
GOTENBERG_BASE_URLS=http://gotenberg:3000,http://gotenberg-2:3000
PHILOLOGIST_AUTO_RUN_ENABLED=1
INTER_AGENT_HANDOFFS_ENABLED=0

# Sender: RuSender only for E2E
SENDER_TRANSPORT=rusender
SENDER_DELAY_SECONDS=5
SENDER_DELAY_MIN_SECONDS=3
SENDER_DELAY_MAX_SECONDS=8
SMTP_ALLOW_REAL_SEND=0

RUSENDER_API_KEY=replace-with-rusender-key
RUSENDER_API_BASE_URL=https://api.rusender.ru/api/v1
RUSENDER_SENDER_NAME=Company Name
RUSENDER_SENDER_EMAIL=replace@example.com
RUSENDER_WEBHOOK_SECRET=replace-with-rusender-webhook-secret

# E2E runner (host or inside app container)
RUN_REAL_E2E=1
E2E_BASE_URL=http://localhost:9806
E2E_USERNAME=admin
E2E_PASSWORD=change-me
E2E_FIXTURES_DIR=tests/e2e/fixtures
E2E_SEND_PAUSE_SECONDS=10
E2E_DOCUMENTS_TIMEOUT_SECONDS=1800
E2E_SENDER_TIMEOUT_SECONDS=600
E2E_CONSENT_TIMEOUT_SECONDS=300
