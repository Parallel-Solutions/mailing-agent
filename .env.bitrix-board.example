# Bitrix24 board dispatcher configuration (copy to .env.bitrix-board)

# Required: incoming webhook from Bitrix24 (same as bitrix mcp/.env)
BITRIX_WEBHOOK_BASE=https://portal.example.ru/rest/123/secret_token

# Optional project defaults
# BITRIX_DEFAULT_GROUP_ID=173
# BITRIX_REPO_GROUP_MAP={"mailing-agent":173}

# Dispatcher settings
BITRIX_BOARD_POLL_INTERVAL_SECONDS=60
BITRIX_BOARD_DB_PATH=.bitrix-board/state.db
BITRIX_BOARD_WORKTREES_DIR=../worktrees
BITRIX_BOARD_MAX_REVIEW_CYCLES=3

# Cursor CLI binary (install: irm https://cursor.com/install.ps1 | iex)
BITRIX_BOARD_AGENT_BIN=agent

# Optional explicit repo root (auto-detected via git otherwise)
# BITRIX_BOARD_REPO_ROOT=C:\random_forest\mailing-agent
