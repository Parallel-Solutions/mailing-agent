{
  "mcpServers": {
    "mailing-agent-campaign": {
      "command": "python",
      "args": ["-m", "src.mcp_server"],
      "cwd": "${workspaceFolder}",
      "env": {
        "MAILING_AGENT_BASE_URL": "http://localhost:9806",
        "MAILING_AGENT_MCP_TOKEN": "replace-with-token"
      }
    }
  }
}
