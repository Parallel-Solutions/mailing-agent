#!/usr/bin/env bash
# ForcedCommand entry point for the dedicated production deploy SSH key.

set -euo pipefail

original_command="${SSH_ORIGINAL_COMMAND:-}"
if [[ ! "$original_command" =~ ^deploy[[:space:]]([0-9a-f]{40})$ ]]; then
  echo "ERROR: only 'deploy <40-char-main-commit-sha>' is allowed" >&2
  exit 64
fi

requested_sha="${BASH_REMATCH[1]}"
nohup sudo -n /usr/local/sbin/mailing-agent-deploy-root "$requested_sha" \
  >/dev/null 2>&1 &
deploy_pid=$!
elapsed=0

while kill -0 "$deploy_pid" 2>/dev/null; do
  sleep 5
  elapsed=$((elapsed + 5))
  if (( elapsed % 30 == 0 )) && kill -0 "$deploy_pid" 2>/dev/null; then
    printf '[deploy] server-side deploy still running (%ss)\n' "$elapsed"
  fi
done

set +e
wait "$deploy_pid"
deploy_status=$?
set -e

if (( deploy_status == 0 )); then
  echo "[deploy] server-side deploy completed successfully"
else
  echo "[deploy] server-side deploy failed with status $deploy_status" >&2
  echo "[deploy] inspect /var/log/mailing-agent-deploy.log on production" >&2
fi
exit "$deploy_status"
